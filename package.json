{
  "name": "vegas-pro-mcp",
  "version": "2.1.1-vegas2027.31",
  "private": true,
  "type": "module",
  "description": "Guarded MCP fork for VEGAS Pro 2027.0.0 Build 31 and OpenAI Codex on Windows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RockZe/vegas-pro-mcp.git"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node tests/mcp-protocol-smoke.mjs",
    "test:native": "node tests/ripple-native.mjs",
    "test:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/install-sandbox.ps1",
    "test:live:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-live-test.ps1",
    "test:live": "node tests/live-acceptance.mjs",
    "build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-extension.ps1",
    "install:extension": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-extension.ps1",
    "setup:codex": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-codex.ps1",
    "doctor": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "probe": "node scripts/probe.mjs",
    "vegas": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-vegas.ps1",
    "package:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
